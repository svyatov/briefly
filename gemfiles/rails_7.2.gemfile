# frozen_string_literal: true

# Pins the Rails line for one CI matrix leg. The root Gemfile reads RAILS_VERSION, so setting it
# here and evaluating that file keeps the dependency list in one place.
#
# Regenerate the lockfile beside this one on Ruby 3.2, the gemspec floor. See CONTRIBUTING.md.
ENV["RAILS_VERSION"] = "7.2"

eval_gemfile File.expand_path("../Gemfile", __dir__)
